# Copy to .env and fill in. Never commit .env. Scripts never print these values.
#
# Back4app → your backend app → App Settings → Security & Keys.
# The browser only ever receives APP_ID, JS_KEY, SERVER_URL and GOOGLE_CLIENT_ID (served by /config.js).
# MASTER_KEY is OPTIONAL: scripts/setup.mjs, scripts/measure.mjs and the tests work with the REST key alone, by calling
# the Cloud functions setupSchema / testCleanup / testWidenAcl (cloud/main.js, guarded by cloud/config.js
# SETUP_ENABLED). If a master key is present they use it directly instead. server.js never reads it.
APP_ID=
JS_KEY=
REST_KEY=
MASTER_KEY=
SERVER_URL=https://parseapi.back4app.com

# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID (type "Web application").
# It is a PUBLIC identifier (it ends up in the HTML), but keep the file out of git anyway.
# The same value goes into Back4app → Authentication → Google → Client ID.
GOOGLE_CLIENT_ID=1234567890-abcdefghijklmnopqrstuvwxyz.apps.googleusercontent.com

# Local development only (npm run dev:server): Postgres database used by the local parse-server.
DATABASE_URL=postgres://localhost:5433/social_dev

# Port the Express server listens on (Containers sets PORT itself).
PORT=8080
